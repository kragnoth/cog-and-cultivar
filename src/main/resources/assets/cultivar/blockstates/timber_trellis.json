{
  "multipart": [
    {
      "when": {
        "cross": "false"
      },
      "apply": {
        "model": "cultivar:block/timber_trellis"
      }
    },
    {
      "when": {
        "cross": "true"
      },
      "apply": {
        "model": "cultivar:block/timber_trellis_cross"
      }
    },
    {
      "when": {
        "cloche": "true"
      },
      "apply": {
        "model": "cultivar:block/bell_cloche"
      }
    }
  ]
}